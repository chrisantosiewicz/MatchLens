# Default local operation needs no account or credentials.
MATCHLENS_AI_MODE=template
# Optional candidate explanation policy; specialist is retained for comparison only.
# MATCHLENS_AI_POLICY=single
# AZURE_TENANT_ID=YOUR-SUBSCRIPTION-TENANT-ID
# MATCHLENS_ALLOW_BROWSER_LOGIN=1
# Administrator-only ingestion is disabled unless a token is set server-side.
# MATCHLENS_INGEST_TOKEN=SET-LOCALLY-NEVER-IN-BROWSER
# MATCHLENS_EVENT_DB=artifacts/events.sqlite
# Model budgets count API requests, not dollars; restart resets the process budget.
# MATCHLENS_MODEL_REQUESTS_PER_MINUTE=6
# MATCHLENS_MODEL_REQUEST_LIMIT=50
# Optional same-origin built frontend; use absolute path on your machine.
# MATCHLENS_FRONTEND_DIR=C:/Soccer Hackathon/frontend/dist
# Set up Azure/Foundry before opting in. Keep real values out of Git.
# AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# AZURE_AI_MODEL_DEPLOYMENT_NAME=YOUR-DEPLOYMENT
# MATCHLENS_AI_MODE=foundry
# Azure identity authentication is required; no credentials belong in browser code.
